dkh:matchConfidence a owl:AnnotationProperty ;
    rdfs:label "match confidence"@en .

dkh:matchVerification a owl:AnnotationProperty ;
    rdfs:label "match verification"@en .

<urn:dkh:link:BRCA1-Q227339> a rdf:Statement ;
