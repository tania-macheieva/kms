    rdf:predicate skos:closeMatch ;
    rdf:subject dkh:BRCA1 ;
    rdfs:comment "мітка збігається; у Wikidata ген і білок — окремі елементи, не з'ясовано, який саме Q227339; тому closeMatch, не sameAs"@uk .

