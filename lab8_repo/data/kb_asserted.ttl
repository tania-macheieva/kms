dkh:Vira a dkh:Person,
        owl:NamedIndividual ;
    rdfs:label "Vira"@en ;
    dkh:hasAgeYears 77 .

dkh:Zoriana a dkh:Person,
        owl:NamedIndividual ;
    rdfs:label "Zoriana"@en ;
    dkh:hasAgeYears 58 ;
