@prefix dct: <http://purl.org/dc/terms/> .
@prefix dkh: <http://example.org/dkh/onto#> .
@prefix ex5: <http://example.org/knowledge-hub/biomed/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/dkh/onto> a owl:Ontology ;
    dct:creator "Студент (власник моделі); чернетки — Claude (LLM), перевірка — студент" ;
    dct:description "Навчальна онтологія; статус довіри: чернетка, не перевірена експертом-медиком; не для клінічного використання."@uk ;
    dct:source "GATK Team, Hard-filtering germline short variants; CDC, About Cascade Testing; таксономія ЛР5; карта ЛР6 v2" ;
    dct:title "Domain Knowledge Hub: онтологія контролю якості геномних варіантів і каскадного тестування"@uk ;
    owl:versionIRI <http://example.org/dkh/onto/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    skos:note "Повторне використання: skos:closeMatch до таксономії ЛР5 (ex5:), skos:exactMatch/closeMatch до MeSH (URI перевірено MeSH Lookup API у ЛР5)." .

dkh:Bohdan a dkh:Person,
        owl:NamedIndividual ;
    rdfs:label "Bohdan"@en ;
    dkh:hasAgeYears 33 ;
    dkh:hasParent dkh:Zoriana .

dkh:CT-01 a dkh:CascadeTesting,
        owl:NamedIndividual ;
    rdfs:label "CT-01"@en ;
    dkh:appliesTo dkh:Andrii,
        dkh:Halyna,
        dkh:Marta,
        dkh:Sofiia ;
    dkh:requires dkh:VAR-001 .

dkh:CT_B a dkh:CascadeTesting,
        owl:NamedIndividual ;
    rdfs:label "CT-B"@en ;
    dkh:appliesTo dkh:Nadiia,
        dkh:Taras,
        dkh:Yana ;
    dkh:requires dkh:VAR-032 .

dkh:FlaggedVariant a owl:Class ;
    rdfs:label "flagged variant"@en,
        "варіант із прапорцем"@uk ;
    rdfs:subClassOf dkh:GeneticVariant ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( dkh:LowQDVariant dkh:HighFSSnpVariant dkh:HighFSIndelVariant [ a owl:Class ;
                        owl:intersectionOf ( dkh:GeneticVariant [ a owl:Restriction ;
                                    owl:onProperty dkh:hasAnnotation ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( dkh:StrandOddsRatio [ a owl:Restriction ;
                                                        owl:onProperty dkh:hasNumericValue ;
                                                        owl:someValuesFrom [ a rdfs:Datatype ;
                                                                owl:onDatatype xsd:decimal ;
                                                                owl:withRestrictions ( [ xsd:minExclusive 3.0 ] ) ] ] ) ] ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( dkh:GeneticVariant [ a owl:Restriction ;
                                    owl:onProperty dkh:hasAnnotation ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( dkh:MappingQuality [ a owl:Restriction ;
                                                        owl:onProperty dkh:hasNumericValue ;
                                                        owl:someValuesFrom [ a rdfs:Datatype ;
                                                                owl:onDatatype xsd:decimal ;
                                                                owl:withRestrictions ( [ xsd:maxExclusive 40.0 ] ) ] ] ) ] ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( dkh:GeneticVariant [ a owl:Restriction ;
                                    owl:onProperty dkh:hasAnnotation ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( dkh:MQRankSum [ a owl:Restriction ;
                                                        owl:onProperty dkh:hasNumericValue ;
                                                        owl:someValuesFrom [ a rdfs:Datatype ;
                                                                owl:onDatatype xsd:decimal ;
                                                                owl:withRestrictions ( [ xsd:maxExclusive -12.5 ] ) ] ] ) ] ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( dkh:GeneticVariant [ a owl:Restriction ;
                                    owl:onProperty dkh:hasAnnotation ;
                                    owl:someValuesFrom [ a owl:Class ;
                                            owl:intersectionOf ( dkh:ReadPosRankSum [ a owl:Restriction ;
                                                        owl:onProperty dkh:hasNumericValue ;
                                                        owl:someValuesFrom [ a rdfs:Datatype ;
                                                                owl:onDatatype xsd:decimal ;
                                                                owl:withRestrictions ( [ xsd:maxExclusive -8.0 ] ) ] ] ) ] ] ) ] ) ] ;
    skos:definition "Варіант із прапорцем — це генетичний варіант, що порушує щонайменше один поріг жорсткої фільтрації й тому підлягає відхиленню."@uk .

dkh:HF-01 a dkh:HardFiltering,
        owl:NamedIndividual ;
    rdfs:label "HF-01"@en ;
    dkh:appliesTo dkh:sample1_vcf ;
    dkh:hasThreshold dkh:FS_gt_200_indel,
        dkh:FS_gt_60_snp,
        dkh:MQRankSum_lt_-12.5,
        dkh:MQ_lt_40,
        dkh:QD_lt_2,
        dkh:ReadPosRankSum_lt_-8,
        dkh:SOR_gt_3 .

dkh:Oleh a dkh:Person,
        owl:NamedIndividual ;
    rdfs:label "Oleh"@en ;
    dkh:hasAgeYears 31 ;
    dkh:hasParent dkh:Lidiia ;
    dkh:hasSibling dkh:Kateryna .

dkh:Situation_S01 a dkh:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "S01 Низький QD"@en ;
    dkh:guardClass dkh:LowQDVariant ;
    dkh:hasAction dkh:S01_a_ApplyFlagAction ;
    dkh:hasGuard "QD < 2" ;
    dkh:hasInitialState dkh:S01_i_UnfilteredState ;
    dkh:hasNewState dkh:S01_n_FlaggedState ;
    dkh:triggeredBy dkh:S01_e_AnnotationComputedEvent .

dkh:Situation_S02 a dkh:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "S02 Високий FS у SNP"@en ;
    dkh:guardClass dkh:HighFSSnpVariant ;
    dkh:hasAction dkh:S02_a_ApplyFlagAction ;
    dkh:hasGuard "FS > 60 і варіант є SNP" ;
    dkh:hasInitialState dkh:S02_i_UnfilteredState ;
    dkh:hasNewState dkh:S02_n_FlaggedState ;
    dkh:triggeredBy dkh:S02_e_AnnotationComputedEvent .

dkh:Situation_S03 a dkh:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "S03 Прапорець FS на кінці екзона"@en ;
    dkh:guardClass dkh:ExonEndVariant ;
    dkh:hasAction dkh:S03_a_ReviewWithSORAction ;
    dkh:hasGuard "єдиний прапорець — FS, варіант у кінці екзона, SOR ≤ 3" ;
    dkh:hasInitialState dkh:S03_i_FlaggedState ;
    dkh:hasNewState dkh:S03_n_UnfilteredState ;
    dkh:triggeredBy dkh:S03_e_AnnotationComputedEvent .

dkh:Situation_S04 a dkh:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "S04 Вибір методу для малої панелі"@en ;
    dkh:guardClass dkh:GenePanel ;
    dkh:hasAction dkh:S04_a_SelectHardFilteringAction ;
    dkh:hasGuard "панель мала: немає великого набору варіантів і підготовлених відомих ресурсів" ;
    dkh:hasInitialState dkh:S04_i_UnfilteredState ;
    dkh:hasNewState dkh:S04_n_UnfilteredState ;
    dkh:triggeredBy dkh:S04_e_MethodChoiceEvent .

dkh:Situation_S05 a dkh:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "S05 Пропозиція тестування дорослому родичу"@en ;
    dkh:guardClass dkh:AdultRelative ;
    dkh:hasAction dkh:S05_a_OfferCascadeTestingAction ;
    dkh:hasGuard "родич повнолітній (вік ≥ 18); починати з родичів першого ступеня (50%)" ;
    dkh:hasInitialState dkh:S05_i_UntestedState ;
    dkh:hasNewState dkh:S05_n_TestingOfferedState ;
    dkh:triggeredBy dkh:S05_e_PathogenicVariantFoundEvent .

dkh:Situation_S06 a dkh:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "S06 Відкладення тестування неповнолітнього"@en ;
    dkh:guardClass dkh:MinorRelative ;
    dkh:hasAction dkh:S06_a_DeferTestingAction ;
    dkh:hasGuard "вік родича < 18" ;
    dkh:hasInitialState dkh:S06_i_UntestedState ;
    dkh:hasNewState dkh:S06_n_TestingDeferredState ;
    dkh:triggeredBy dkh:S06_e_TestingRequestedEvent .

dkh:carries a owl:ObjectProperty ;
    rdfs:label "carries"@en,
        "несе"@uk ;
    rdfs:domain dkh:Person ;
    rdfs:range dkh:GeneticVariant ;
    skos:definition "Особа є носієм варіанта."@uk .

dkh:detects a owl:ObjectProperty ;
    rdfs:label "detects"@en,
        "виявляє"@uk ;
    rdfs:domain dkh:Procedure ;
    rdfs:range dkh:GeneticVariant ;
    skos:definition "Процедура виявляє варіант."@uk .

dkh:forVariantType a owl:DatatypeProperty ;
    rdfs:label "for variant type"@en,
        "для типу варіанта"@uk ;
    rdfs:domain dkh:FilterThreshold ;
    rdfs:range xsd:string ;
    skos:definition "SNP, INDEL або всі."@uk .

dkh:guardClass a owl:AnnotationProperty ;
    rdfs:label "guard class"@en .

dkh:hasAction a owl:ObjectProperty ;
    rdfs:label "has action"@en,
        "має дію"@uk ;
    rdfs:domain dkh:SituationTemplate ;
    rdfs:range dkh:Action ;
    skos:definition "Дія/наслідок шаблона."@uk .

dkh:hasComparisonOperator a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has comparison operator"@en,
        "має оператор порівняння"@uk ;
    rdfs:domain dkh:FilterThreshold ;
    rdfs:range xsd:string ;
    skos:definition "«<» або «>»."@uk .

dkh:hasCousin a owl:ObjectProperty ;
    rdfs:label "has cousin"@en,
        "має двоюрідного родича"@uk ;
    rdfs:domain dkh:Person ;
    rdfs:range dkh:Person ;
    rdfs:subPropertyOf dkh:isThirdDegreeRelativeOf ;
    owl:propertyChainAxiom ( dkh:hasAuntOrUncle dkh:hasChild ) ;
    skos:definition "Ланцюг hasAuntOrUncle∘hasChild."@uk .

dkh:hasDiagnosis a owl:ObjectProperty ;
    rdfs:label "has diagnosis"@en,
        "має діагноз"@uk ;
    rdfs:domain dkh:Person ;
    rdfs:range dkh:Disease ;
    skos:definition "Особі встановлено діагноз."@uk .

dkh:hasGrandparent a owl:ObjectProperty ;
    rdfs:label "has grandparent"@en,
        "має бабусю/дідуся"@uk ;
    rdfs:domain dkh:Person ;
    rdfs:range dkh:Person ;
    rdfs:subPropertyOf dkh:isSecondDegreeRelativeOf ;
    owl:propertyChainAxiom ( dkh:hasParent dkh:hasParent ) ;
    skos:definition "Ланцюг hasParent∘hasParent."@uk .

dkh:hasGuard a owl:DatatypeProperty ;
    rdfs:label "has guard"@en,
        "має умову (guard)"@uk ;
    rdfs:domain dkh:SituationTemplate ;
    rdfs:range xsd:string ;
    skos:definition "Умова спрацювання."@uk .

dkh:hasInitialState a owl:ObjectProperty ;
    rdfs:label "has initial state"@en,
        "має початковий стан"@uk ;
    rdfs:domain dkh:SituationTemplate ;
    rdfs:range dkh:State ;
    skos:definition "Початковий стан шаблона."@uk .

dkh:hasNewState a owl:ObjectProperty ;
    rdfs:label "has new state"@en,
        "має новий стан"@uk ;
    rdfs:domain dkh:SituationTemplate ;
    rdfs:range dkh:State ;
    skos:definition "Новий стан шаблона."@uk .

dkh:hasThreshold a owl:ObjectProperty ;
    rdfs:label "has threshold"@en,
        "має поріг"@uk ;
    rdfs:domain dkh:Procedure ;
    rdfs:range dkh:FilterThreshold ;
    skos:definition "Процедура використовує поріг."@uk .

dkh:hasThresholdValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has threshold value"@en,
        "має значення порога"@uk ;
    rdfs:domain dkh:FilterThreshold ;
    rdfs:range xsd:decimal ;
    skos:definition "Граничне значення."@uk .

dkh:hasVariantId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has variant id"@en,
        "має ідентифікатор варіанта"@uk ;
    rdfs:domain dkh:GeneticVariant ;
    rdfs:range xsd:string ;
    skos:definition "Ідентифікатор."@uk .

dkh:isDeceased a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "is deceased"@en,
        "померла/помер"@uk ;
    rdfs:domain dkh:Person ;
    rdfs:range xsd:boolean ;
    skos:definition "Ознака, що особа померла (ідея запозичена з чернетки LLM)."@uk .

dkh:locatedIn a owl:ObjectProperty ;
    rdfs:label "located in"@en,
        "розташований у"@uk ;
    rdfs:domain dkh:GeneticVariant ;
    rdfs:range dkh:Gene ;
    skos:definition "Варіант розташований у гені."@uk .

dkh:onAnnotationName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "on annotation name"@en,
        "для анотації"@uk ;
    rdfs:domain dkh:FilterThreshold ;
    rdfs:range xsd:string ;
    skos:definition "Назва анотації (QD, FS…)."@uk .

dkh:produces a owl:ObjectProperty ;
    rdfs:label "produces"@en,
        "створює"@uk ;
    rdfs:domain dkh:Procedure ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( dkh:DataArtifact dkh:GeneticVariant ) ] ;
    skos:definition "Процедура створює дані чи варіанти."@uk .

dkh:recordedIn a owl:ObjectProperty ;
    rdfs:label "recorded in"@en ;
    rdfs:comment "Додано в ЛР8 (збагачення даних): варіант записано у VCF-файлі."@uk ;
    rdfs:domain dkh:GeneticVariant ;
    rdfs:range dkh:VCFFile .

dkh:triggeredBy a owl:ObjectProperty ;
    rdfs:label "triggered by"@en,
        "ініціюється подією"@uk ;
    rdfs:domain dkh:SituationTemplate ;
    rdfs:range dkh:Event ;
    skos:definition "Подія шаблона."@uk .

dkh:DeferTestingAction a owl:Class ;
    rdfs:label "defer testing action"@en,
        "дія «відкласти тестування»"@uk ;
    rdfs:subClassOf dkh:Action ;
    skos:definition "Дія «відкласти тестування» — це дія, що відкладає тестування до повноліття."@uk .

dkh:Exon a owl:Class ;
    rdfs:label "exon"@en,
        "екзон"@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dkh:partOf ;
            owl:someValuesFrom dkh:Gene ],
        dkh:BiologicalEntity ;
    skos:closeMatch ex5:C009 ;
    skos:definition "Екзон — це біологічна сутність, що є ділянкою гена, яка зберігається у зрілій РНК."@uk .

dkh:FS_gt_200_indel a dkh:FilterThreshold,
        owl:NamedIndividual ;
    rdfs:label "FS > 200.0 (INDEL)"@en ;
    dkh:forVariantType "INDEL" ;
    dkh:hasComparisonOperator ">" ;
    dkh:hasThresholdValue 200.0 ;
    dkh:onAnnotationName "FS" .

dkh:FS_gt_60_snp a dkh:FilterThreshold,
        owl:NamedIndividual ;
    rdfs:label "FS > 60.0 (SNP)"@en ;
    dkh:forVariantType "SNP" ;
    dkh:hasComparisonOperator ">" ;
    dkh:hasThresholdValue 60.0 ;
    dkh:onAnnotationName "FS" .

dkh:FamilyHistory a owl:Class ;
    rdfs:label "family history"@en,
        "родинний анамнез"@uk ;
    rdfs:subClassOf dkh:DataArtifact ;
    skos:closeMatch ex5:C088 ;
    skos:definition "Родинний анамнез — це артефакт даних, що описує випадки захворювань серед родичів особи."@uk .

dkh:FilteredState a owl:Class ;
    rdfs:label "filtered state"@en,
        "відфільтрований стан"@uk ;
    rdfs:subClassOf dkh:State ;
    skos:definition "Відфільтрований стан — це стан, в якому варіант відхилено."@uk .

dkh:GeneticCounseling a owl:Class ;
    rdfs:label "genetic counseling"@en,
        "генетичне консультування"@uk ;
    rdfs:subClassOf dkh:Procedure ;
    skos:closeMatch ex5:C070 ;
    skos:definition "Генетичне консультування — це процедура, що пояснює пацієнту й родині результати та ризики тестування."@uk ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D005817> .

dkh:GermlineVariant a owl:Class ;
    rdfs:label "germline variant"@en,
        "зародковий варіант"@uk ;
    rdfs:subClassOf dkh:GeneticVariant ;
    skos:closeMatch ex5:C030 ;
    skos:definition "Зародковий варіант — це генетичний варіант, що наявний у клітинах зародкової лінії й успадковується."@uk .

dkh:HighFSIndelVariant a owl:Class ;
    rdfs:label "high FS indel"@en,
        "INDEL із високим FS"@uk ;
    rdfs:subClassOf dkh:Indel ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dkh:Indel [ a owl:Restriction ;
                        owl:onProperty dkh:hasAnnotation ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( dkh:FisherStrandBias [ a owl:Restriction ;
                                            owl:onProperty dkh:hasNumericValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:decimal ;
                                                    owl:withRestrictions ( [ xsd:minExclusive 200.0 ] ) ] ] ) ] ] ) ] ;
    skos:definition "INDEL із високим FS — це вставка-делеція, що має анотацію FS зі значенням більше 200."@uk .

dkh:Iryna_OC a dkh:OvarianCancer,
        owl:NamedIndividual ;
    rdfs:label "ovarian cancer (Iryna)"@en .

dkh:Kateryna a dkh:Person,
        dkh:Proband,
        owl:NamedIndividual ;
    rdfs:label "Kateryna"@en ;
    dkh:carries dkh:VAR-025 ;
    dkh:hasAgeYears 35 ;
    dkh:hasDiagnosis dkh:Kateryna_dx ;
    dkh:hasParent dkh:Lidiia .

dkh:Kateryna_dx a dkh:OvarianCancer,
        owl:NamedIndividual ;
    rdfs:label "OvarianCancer (Kateryna)"@en .

dkh:LowQDAnnotation a owl:Class ;
    rdfs:label "low QD annotation"@en,
        "низька анотація QD"@uk ;
    rdfs:subClassOf dkh:QualityByDepth ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dkh:QualityByDepth [ a owl:Restriction ;
                        owl:onProperty dkh:hasNumericValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:maxExclusive 2.0 ] ) ] ] ) ] ;
    skos:definition "Низька анотація QD — це якість на глибину, зі значенням менше 2."@uk .

dkh:MQRankSum_lt_-12.5 a dkh:FilterThreshold,
        owl:NamedIndividual ;
    rdfs:label "MQRankSum < -12.5 (all)"@en ;
    dkh:forVariantType "all" ;
    dkh:hasComparisonOperator "<" ;
    dkh:hasThresholdValue -12.5 ;
    dkh:onAnnotationName "MQRankSum" .

dkh:MQ_lt_40 a dkh:FilterThreshold,
        owl:NamedIndividual ;
    rdfs:label "MQ < 40.0 (all)"@en ;
    dkh:forVariantType "all" ;
    dkh:hasComparisonOperator "<" ;
    dkh:hasThresholdValue 40.0 ;
    dkh:onAnnotationName "MQ" .

dkh:MethodChoiceEvent a owl:Class ;
    rdfs:label "method choice event"@en,
        "подія вибору методу"@uk ;
    rdfs:subClassOf dkh:Event ;
    skos:definition "Подія вибору методу — це подія, в якій потрібно вибрати метод фільтрації для набору даних."@uk .

dkh:Nadiia a dkh:Person,
        owl:NamedIndividual ;
    rdfs:label "Nadiia"@en ;
    dkh:hasAgeYears 48 ;
    dkh:hasParent dkh:Mykola,
        dkh:Vira ;
    dkh:hasSibling dkh:Pavlo .

dkh:OfferCascadeTestingAction a owl:Class ;
    rdfs:label "offer cascade testing action"@en,
        "дія «запропонувати каскадне тестування»"@uk ;
    rdfs:subClassOf dkh:Action ;
    skos:definition "Дія «запропонувати каскадне тестування» — це дія, що пропонує тестування родичу."@uk .

dkh:Olena_BC a dkh:BreastCancer,
        owl:NamedIndividual ;
    rdfs:label "breast cancer (Olena)"@en .

dkh:PathogenicVariant a owl:Class ;
    rdfs:label "pathogenic variant"@en,
        "патогенний варіант"@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dkh:increasesRiskOf ;
            owl:someValuesFrom dkh:OvarianCancer ],
        [ a owl:Restriction ;
            owl:onProperty dkh:increasesRiskOf ;
            owl:someValuesFrom dkh:BreastCancer ],
        dkh:GeneticVariant ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dkh:GeneticVariant [ a owl:Restriction ;
                        owl:onProperty dkh:hasClinicalSignificance ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:oneOf ( dkh:Pathogenic ) ] ] ) ] ;
    skos:closeMatch ex5:C033 ;
    skos:definition "Патогенний варіант — це генетичний варіант, якому приписано клінічне значення «патогенний»."@uk .

dkh:PathogenicVariantFoundEvent a owl:Class ;
    rdfs:label "pathogenic variant found event"@en,
        "подія виявлення патогенного варіанта"@uk ;
    rdfs:subClassOf dkh:Event ;
    skos:definition "Подія виявлення патогенного варіанта — це подія, в якій у пробанда виявлено патогенний варіант."@uk .

dkh:Pavlo_dx a dkh:BreastCancer,
        owl:NamedIndividual ;
    rdfs:label "BreastCancer (Pavlo)"@en .

dkh:QD_lt_2 a dkh:FilterThreshold,
        owl:NamedIndividual ;
    rdfs:label "QD < 2.0 (all)"@en ;
