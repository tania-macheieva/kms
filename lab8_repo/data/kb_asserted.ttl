    dkh:hasAgeYears 68 ;
    dkh:hasDiagnosis dkh:Iryna_OC ;
    dkh:hasParent dkh:Maria ;
    dkh:hasSibling dkh:Halyna .

dkh:Pavlo a dkh:Person,
