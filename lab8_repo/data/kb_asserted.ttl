    rdfs:label "Stefa"@en ;
    dkh:hasAgeYears 85 ;
    dkh:isDeceased true .

dkh:TestingDeferredState a owl:Class ;
    rdfs:label "testing deferred state"@en,
        "стан відкладеного тестування"@uk ;
    rdfs:subClassOf dkh:State ;
    skos:definition "Стан відкладеного тестування — це стан, в якому тестування відкладено."@uk .

dkh:TestingOfferedState a owl:Class ;
    rdfs:label "testing offered state"@en,
        "стан запропонованого тестування"@uk ;
    rdfs:subClassOf dkh:State ;
    skos:definition "Стан запропонованого тестування — це стан, в якому родичу запропоновано тестування."@uk .

dkh:VAR-004 a dkh:SNP,
