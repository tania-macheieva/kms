dkh:VQSR a owl:Class ;
    rdfs:label "variant quality score recalibration"@en,
        "рекалібрування якості варіантів (VQSR)"@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dkh:requires ;
            owl:someValuesFrom dkh:LargeVariantSet ],
        [ a owl:Restriction ;
            owl:onProperty dkh:requires ;
            owl:someValuesFrom dkh:CuratedKnownVariants ],
        dkh:VariantFiltering ;
    skos:closeMatch ex5:C064 ;
    skos:definition "Рекалібрування якості варіантів (VQSR) — це фільтрація варіантів, що навчає модель на великому наборі варіантів і відомих ресурсах."@uk .

dkh:VariantCalling a owl:Class ;
    rdfs:label "variant calling"@en,
        "виклик варіантів"@uk ;
    rdfs:subClassOf dkh:Procedure ;
    skos:closeMatch ex5:C060 ;
    skos:definition "Виклик варіантів — це процедура, що визначає варіанти за вирівняними прочитаннями."@uk .

dkh:Yana a dkh:Person,
        owl:NamedIndividual ;
    rdfs:label "Yana"@en ;
    dkh:hasAgeYears 22 ;
    dkh:hasParent dkh:Pavlo .

dkh:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies_to"@en,
        "застосовується до"@uk ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( dkh:Procedure dkh:QualityMeasure ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( dkh:GeneticVariant dkh:DataArtifact dkh:Person ) ] ;
    skos:definition "Процедура чи показник застосовується до об'єкта."@uk .

dkh:derivedFrom a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "derived from"@en,
        "походить від"@uk ;
    rdfs:domain dkh:DataFile ;
    rdfs:range dkh:DataFile ;
    skos:definition "Файл отримано з іншого файла (походження, транзитивно)."@uk .

dkh:generatedBy a owl:ObjectProperty ;
    rdfs:label "generated by"@en,
        "створено сенсором"@uk ;
    rdfs:domain dkh:DataFile ;
    rdfs:range dkh:Sensor ;
    skos:definition "Файл створено сенсором (секвенатором)."@uk .

dkh:hasAncestor a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has ancestor"@en,
        "має предка"@uk ;
    rdfs:domain dkh:Person ;
    rdfs:range dkh:Person ;
    skos:definition "Транзитивний зв'язок «предок»."@uk .

dkh:hasAuntOrUncle a owl:ObjectProperty ;
    rdfs:label "has aunt or uncle"@en,
        "має тітку/дядька"@uk ;
    rdfs:domain dkh:Person ;
    rdfs:range dkh:Person ;
    rdfs:subPropertyOf dkh:isSecondDegreeRelativeOf ;
    owl:propertyChainAxiom ( dkh:hasParent dkh:hasSibling ) ;
    skos:definition "Ланцюг hasParent∘hasSibling."@uk .

dkh:hasExonEndPosition a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has exon end position"@en,
        "розташований на кінці екзона"@uk ;
    rdfs:domain dkh:GeneticVariant ;
    rdfs:range xsd:boolean ;
    skos:definition "true, якщо варіант на кінці екзона."@uk .

dkh:hasPart a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has part"@en,
        "має частину"@uk ;
    rdfs:domain dkh:BiologicalEntity ;
    rdfs:range dkh:BiologicalEntity ;
    skos:definition "Обернена до partOf."@uk .

dkh:hasSibling a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has sibling"@en,
        "має брата/сестру"@uk ;
    rdfs:domain dkh:Person ;
    rdfs:range dkh:Person ;
    rdfs:subPropertyOf dkh:isFirstDegreeRelativeOf ;
    skos:definition "Рідний брат або сестра."@uk .

dkh:isAnnotationOf a owl:ObjectProperty ;
    rdfs:label "is annotation of"@en,
        "є анотацією варіанта"@uk ;
    rdfs:domain dkh:QualityAnnotation ;
    rdfs:range dkh:GeneticVariant ;
    skos:definition "Обернена до hasAnnotation."@uk .

dkh:isMemberOf a owl:ObjectProperty ;
    rdfs:label "is member of"@en,
        "є елементом"@uk ;
    rdfs:domain dkh:Gene ;
    rdfs:range dkh:GenePanel ;
    skos:definition "Обернена до hasMember."@uk .

dkh:partOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "part_of"@en,
        "є складовою"@uk ;
    rdfs:domain dkh:BiologicalEntity ;
    rdfs:range dkh:BiologicalEntity ;
    owl:inverseOf dkh:hasPart ;
    skos:definition "Об'єкт є частиною цілого (транзитивно)."@uk .

dkh:sample1_bam a dkh:BAMFile,
        owl:NamedIndividual ;
    rdfs:label "sample1.bam"@en ;
    dkh:generatedBy dkh:Sequencer1 .

dkh:sample2_bam a dkh:BAMFile,
        owl:NamedIndividual ;
    rdfs:label "sample2.bam"@en ;
    dkh:generatedBy dkh:Sequencer1 .

dkh:sample3_bam a dkh:BAMFile,
        owl:NamedIndividual ;
    rdfs:label "sample3.bam"@en ;
    dkh:generatedBy dkh:Sequencer1 .

dkh:AdultRelative a owl:Class ;
    rdfs:label "adult relative"@en,
        "дорослий родич"@uk ;
    rdfs:subClassOf dkh:Relative ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dkh:Relative [ a owl:Restriction ;
                        owl:onProperty dkh:hasAgeYears ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 18 ] ) ] ] ) ] ;
    skos:definition "Дорослий родич — це родич, якому щонайменше 18 років."@uk .

dkh:Andrii a dkh:Person,
        owl:NamedIndividual ;
    rdfs:label "Andrii"@en ;
    dkh:hasAgeYears 40 .

dkh:ApplyFlagAction a owl:Class ;
    rdfs:label "apply flag action"@en,
        "дія «поставити прапорець»"@uk ;
    rdfs:subClassOf dkh:Action ;
    skos:definition "Дія «поставити прапорець» — це дія, що позначає варіант прапорцем порогу."@uk .

dkh:Cancer a owl:Class ;
    rdfs:label "cancer"@en,
        "рак"@uk ;
    rdfs:subClassOf dkh:Disease ;
    skos:definition "Рак — це захворювання, що характеризується неконтрольованим ростом клітин."@uk .

dkh:CascadeTesting a owl:Class ;
    rdfs:label "cascade testing"@en,
        "каскадне тестування"@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dkh:recommendedFor ;
            owl:someValuesFrom dkh:FirstDegreeRelative ],
        [ a owl:Restriction ;
            owl:allValuesFrom dkh:Relative ;
            owl:onProperty dkh:appliesTo ],
        [ a owl:Restriction ;
            owl:onProperty dkh:requires ;
            owl:someValuesFrom dkh:PathogenicVariant ],
        dkh:GeneticTesting ;
    skos:closeMatch ex5:C069 ;
    skos:definition "Каскадне тестування — це генетичне тестування, що пропонують родичам пробанда після виявлення в нього патогенного варіанта."@uk .

dkh:CuratedKnownVariants a owl:Class ;
    rdfs:label "curated known variants"@en,
        "підготовлені відомі варіанти"@uk ;
    rdfs:subClassOf dkh:DataArtifact ;
    skos:definition "Підготовлені відомі варіанти — це артефакт даних, що є перевіреним ресурсом відомих варіантів для навчання VQSR."@uk .

dkh:ExonEndVariant a owl:Class ;
    rdfs:label "variant at exon end"@en,
        "варіант у кінці екзона"@uk ;
    rdfs:subClassOf dkh:GeneticVariant ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dkh:GeneticVariant [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty dkh:hasExonEndPosition ] ) ] ;
    skos:definition "Варіант у кінці екзона — це генетичний варіант, розташований на кінці екзона."@uk .

dkh:FirstDegreeRelative a owl:Class ;
    rdfs:label "first-degree relative"@en,
        "родич першого ступеня"@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 0.5 ;
            owl:onProperty dkh:hasInheritanceProbability ],
        dkh:Relative ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dkh:Person [ a owl:Restriction ;
                        owl:onProperty dkh:isFirstDegreeRelativeOf ;
                        owl:someValuesFrom dkh:Proband ] ) ] ;
    skos:definition "Родич першого ступеня — це родич, що є батьком/матір'ю, дитиною або рідним братом/сестрою пробанда."@uk .

dkh:GeneticTesting a owl:Class ;
    rdfs:label "genetic testing"@en,
        "генетичне тестування"@uk ;
    rdfs:subClassOf dkh:Procedure ;
    skos:closeMatch ex5:C068 ;
    skos:definition "Генетичне тестування — це процедура, що виявляє варіанти в генах пацієнта."@uk .

dkh:HardFiltering a owl:Class ;
    rdfs:label "hard filtering"@en,
        "жорстка фільтрація"@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dkh:usesInput ;
            owl:someValuesFrom dkh:StrandOddsRatio ],
        [ a owl:Restriction ;
            owl:onProperty dkh:usesInput ;
            owl:someValuesFrom dkh:RankSumAnnotation ],
        [ a owl:Restriction ;
            owl:onProperty dkh:usesInput ;
            owl:someValuesFrom dkh:MappingQuality ],
        [ a owl:Restriction ;
            owl:onProperty dkh:recommendedFor ;
            owl:someValuesFrom dkh:GenePanel ],
        [ a owl:Restriction ;
            owl:onProperty dkh:usesInput ;
            owl:someValuesFrom dkh:FisherStrandBias ],
        [ a owl:Restriction ;
            owl:onProperty dkh:usesInput ;
            owl:someValuesFrom dkh:QualityByDepth ],
        dkh:VariantFiltering ;
    skos:closeMatch ex5:C063 ;
    skos:definition "Жорстка фільтрація — це фільтрація варіантів, що відкидає варіанти за фіксованими порогами анотацій."@uk .

dkh:HighFSSnpVariant a owl:Class ;
    rdfs:label "high FS SNP"@en,
        "SNP із високим FS"@uk ;
    rdfs:subClassOf dkh:SNP ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dkh:SNP [ a owl:Restriction ;
                        owl:onProperty dkh:hasAnnotation ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( dkh:FisherStrandBias [ a owl:Restriction ;
                                            owl:onProperty dkh:hasNumericValue ;
                                            owl:someValuesFrom [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:decimal ;
                                                    owl:withRestrictions ( [ xsd:minExclusive 60.0 ] ) ] ] ) ] ] ) ] ;
    skos:definition "SNP із високим FS — це однонуклеотидний поліморфізм, що має анотацію FS зі значенням більше 60."@uk .

dkh:LargeVariantSet a owl:Class ;
    rdfs:label "large variant set"@en,
        "великий набір варіантів"@uk ;
    rdfs:subClassOf dkh:DataArtifact ;
    skos:definition "Великий набір варіантів — це артефакт даних, достатньо великий, щоб навчити модель VQSR."@uk .

dkh:Lidiia a dkh:Person,
        owl:NamedIndividual ;
    rdfs:label "Lidiia"@en ;
    dkh:hasAgeYears 60 ;
    dkh:hasParent dkh:Stefa ;
    dkh:hasSibling dkh:Zoriana .

dkh:LowQDVariant a owl:Class ;
    rdfs:label "low QD variant"@en,
        "варіант із низьким QD"@uk ;
    rdfs:subClassOf dkh:GeneticVariant ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dkh:GeneticVariant [ a owl:Restriction ;
                        owl:onProperty dkh:hasAnnotation ;
                        owl:someValuesFrom dkh:LowQDAnnotation ] ) ] ;
    skos:definition "Варіант із низьким QD — це генетичний варіант, що має анотацію QD зі значенням менше 2."@uk .

dkh:MQRankSum a owl:Class ;
    rdfs:label "MQRankSum"@en,
        "MQRankSum"@uk ;
    rdfs:subClassOf dkh:RankSumAnnotation ;
    skos:definition "MQRankSum — це тест суми рангів, що порівнює якості картування прочитань референсного й альтернативного алелів."@uk .

dkh:Maria a dkh:Person,
        owl:NamedIndividual ;
    rdfs:label "Maria"@en ;
    dkh:hasChild dkh:Halyna,
        dkh:Iryna ;
    dkh:isDeceased true .

dkh:Marta a dkh:Person,
        owl:NamedIndividual ;
    rdfs:label "Marta"@en ;
    dkh:hasAgeYears 39 ;
    dkh:hasParent dkh:Iryna,
        dkh:Petro ;
    dkh:hasSibling dkh:Olena .

dkh:MinorRelative a owl:Class ;
    rdfs:label "minor relative"@en,
        "неповнолітній родич"@uk ;
    rdfs:subClassOf dkh:Relative ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dkh:Relative [ a owl:Restriction ;
                        owl:onProperty dkh:hasAgeYears ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 18 ] ) ] ] ) ] ;
    skos:definition "Неповнолітній родич — це родич, якому менше 18 років."@uk .

dkh:Mykola a dkh:Person,
        owl:NamedIndividual ;
    rdfs:label "Mykola"@en ;
    dkh:hasAgeYears 79 ;
    dkh:isDeceased true .

dkh:Olena a dkh:Proband,
        owl:NamedIndividual ;
    rdfs:label "Olena"@en ;
    dkh:carries dkh:VAR-001 ;
    dkh:hasAgeYears 42 ;
    dkh:hasDiagnosis dkh:Olena_BC ;
    dkh:hasParent dkh:Iryna,
        dkh:Petro ;
    dkh:hasSibling dkh:Marta .

dkh:Petro a dkh:Person,
        owl:NamedIndividual ;
    rdfs:label "Petro"@en ;
    dkh:hasAgeYears 70 .

dkh:ReadPosRankSum a owl:Class ;
    rdfs:label "ReadPosRankSum"@en,
        "ReadPosRankSum"@uk ;
    rdfs:subClassOf dkh:RankSumAnnotation ;
    skos:definition "ReadPosRankSum — це тест суми рангів, що порівнює позиції алелів у прочитаннях."@uk .

dkh:Sequencer a owl:Class ;
    rdfs:label "sequencer"@en,
        "секвенатор"@uk ;
    rdfs:subClassOf dkh:Sensor ;
    skos:definition "Секвенатор — це сенсор, що зчитує послідовність ДНК і породжує прочитання."@uk .

dkh:Stefa a dkh:Person,
