PREFIX ex: <http://example.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?a (COUNT(DISTINCT ?g) AS ?s) WHERE { ex:D076 rdf:type ex:Disease ; ex:assocGene ?g . ?g rdf:type ex:Gene . ?o rdf:type ex:Disease ; ex:assocGene ?g . FILTER(?o != ex:D076) BIND(STRAFTER(STR(?o), "http://example.org/") AS ?a) } GROUP BY ?a HAVING (COUNT(DISTINCT ?g) >= 2) ORDER BY DESC(?s) ?a
