@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org/knowledge-hub/biomed/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ex:C004 a skos:Concept ;
    skos:altLabel "whole genome"@en ;
    skos:broader ex:C003 ;
    skos:definition "Повний набір спадкового матеріалу (ДНК) організму."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C004" ;
    skos:prefLabel "genome"@en,
        "геном"@uk .

ex:C005 a skos:Concept ;
    skos:broader ex:C003 ;
    skos:definition "Структура з ДНК і білків, що несе гени; у людини 23 пари."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C005" ;
    skos:prefLabel "chromosome"@en,
        "хромосома"@uk .

ex:C007 a skos:Concept ;
    skos:broader ex:C006 ;
    skos:definition "Ген репарації ДНК; патогенні варіанти підвищують ризик раку молочної залози й яєчників."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C007" ;
    skos:prefLabel "BRCA1"@en,
        "BRCA1"@uk .

ex:C008 a skos:Concept ;
    skos:broader ex:C006 ;
    skos:definition "Ген репарації ДНК; патогенні варіанти підвищують ризик раку молочної залози й яєчників."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C008" ;
    skos:prefLabel "BRCA2"@en,
        "BRCA2"@uk .

ex:C009 a skos:Concept ;
    skos:broader ex:C003 ;
    skos:definition "Ділянка гена, що лишається в зрілій РНК і може кодувати білок."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C009" ;
    skos:prefLabel "exon"@en,
        "екзон"@uk .

ex:C010 a skos:Concept ;
    skos:broader ex:C003 ;
    skos:definition "Ділянка гена, що видаляється зі зрілої РНК під час сплайсингу."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C010" ;
    skos:prefLabel "intron"@en,
        "інтрон"@uk .

ex:C011 a skos:Concept ;
    skos:broader ex:C003 ;
    skos:definition "Сукупність усіх екзонів геному."@uk ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D059472> ;
    skos:inScheme ex:scheme ;
    skos:notation "C011" ;
    skos:prefLabel "exome"@en,
        "екзом"@uk .

ex:C012 a skos:Concept ;
    skos:altLabel "RNA transcript"@en ;
    skos:broader ex:C003 ;
    skos:definition "Молекула РНК, синтезована на матриці ДНК."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C012" ;
    skos:prefLabel "transcript"@en,
        "транскрипт"@uk .

ex:C013 a skos:Concept ;
    skos:broader ex:C003 ;
    skos:definition "Сукупність усіх РНК-транскриптів клітини чи тканини."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C013" ;
    skos:prefLabel "transcriptome"@en,
        "транскриптом"@uk .

ex:C014 a skos:Concept ;
    skos:altLabel "gene panel test"@en,
        "targeted panel"@en ;
    skos:broader ex:C003 ;
    skos:definition "Набір вибраних генів, що аналізуються разом."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C014" ;
    skos:prefLabel "gene panel"@en,
        "генна панель"@uk .

ex:C016 a skos:Concept ;
    skos:broader ex:C015 ;
    skos:definition "Органічна сполука, мономер білків."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C016" ;
    skos:prefLabel "amino acid"@en,
        "амінокислота"@uk .

ex:C017 a skos:Concept ;
    skos:broader ex:C015 ;
    skos:definition "Короткий ланцюжок амінокислот."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C017" ;
    skos:prefLabel "peptide"@en,
        "пептид"@uk .

ex:C018 a skos:Concept ;
    skos:broader ex:C015 ;
    skos:definition "Біополімер із амінокислот, що виконує структурні й функціональні ролі."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C018" ;
    skos:prefLabel "protein"@en,
        "білок"@uk .

ex:C019 a skos:Concept ;
    skos:altLabel "domain"@en ;
    skos:broader ex:C015 ;
    skos:definition "Структурно й функціонально відокремлена частина білка."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C019" ;
    skos:prefLabel "protein domain"@en,
        "білковий домен"@uk .

ex:C020 a skos:Concept ;
    skos:broader ex:C015 ;
    skos:definition "Сукупність усіх білків клітини, тканини чи організму."@uk ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D020543> ;
    skos:inScheme ex:scheme ;
    skos:notation "C020" ;
    skos:prefLabel "proteome"@en,
        "протеом"@uk .

ex:C023 a skos:Concept ;
    skos:altLabel "SNP"@en,
        "SNV"@en,
        "single nucleotide variant"@en ;
    skos:broader ex:C022 ;
    skos:definition "Заміна одного нуклеотида в певній позиції геному."@uk ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D020641> ;
    skos:inScheme ex:scheme ;
    skos:notation "C023" ;
    skos:prefLabel "single nucleotide polymorphism"@en,
        "однонуклеотидний поліморфізм"@uk .

ex:C024 a skos:Concept ;
    skos:altLabel "indel"@en,
        "insertion deletion"@en ;
    skos:broader ex:C022 ;
    skos:definition "Вставка або видалення невеликого числа нуклеотидів у послідовності."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C024" ;
    skos:prefLabel "insertion-deletion"@en,
        "інсерція-делеція"@uk .

ex:C025 a skos:Concept ;
    skos:altLabel "SV"@en ;
    skos:broader ex:C022 ;
    skos:definition "Велика зміна геному (від ~50 нуклеотидів): делеція, дуплікація, інверсія, транслокація."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C025" ;
    skos:prefLabel "structural variant"@en,
        "структурний варіант"@uk .

ex:C026 a skos:Concept ;
    skos:altLabel "CNV"@en,
        "copy number variant"@en ;
    skos:broader ex:C022 ;
    skos:definition "Зміна кількості копій ділянки геному відносно референсу."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C026" ;
    skos:prefLabel "copy number variation"@en,
        "варіація числа копій"@uk .

ex:C027 a skos:Concept ;
    skos:broader ex:C022 ;
    skos:definition "Стійка зміна послідовності ДНК."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C027" ;
    skos:prefLabel "mutation"@en,
        "мутація"@uk .

ex:C028 a skos:Concept ;
    skos:broader ex:C022 ;
    skos:definition "Одна з альтернативних форм гена або ділянки ДНК у певному локусі."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C028" ;
    skos:prefLabel "allele"@en,
        "алель"@uk .

ex:C030 a skos:Concept ;
    skos:altLabel "hereditary variant"@en,
        "inherited variant"@en ;
    skos:broader ex:C029 ;
    skos:definition "Варіант у статевих клітинах, що передається нащадкам і присутній у всіх клітинах організму."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C030" ;
    skos:prefLabel "germline variant"@en,
        "germline-варіант"@uk .

ex:C031 a skos:Concept ;
    skos:altLabel "somatic mutation"@en ;
    skos:broader ex:C029 ;
    skos:definition "Варіант, набутий у соматичній клітині, не спадковий."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C031" ;
    skos:prefLabel "somatic variant"@en,
        "соматичний варіант"@uk .

ex:C033 a skos:Concept ;
    skos:altLabel "disease-causing variant"@en ;
    skos:broader ex:C032 ;
    skos:definition "Варіант, що за доказами спричиняє захворювання або підвищує ризик."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C033" ;
    skos:prefLabel "pathogenic variant"@en,
        "патогенний варіант"@uk .

ex:C034 a skos:Concept ;
    skos:broader ex:C032 ;
    skos:definition "Варіант, що за доказами не спричиняє захворювання."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C034" ;
    skos:prefLabel "benign variant"@en,
        "доброякісний варіант"@uk .

ex:C035 a skos:Concept ;
    skos:altLabel "VUS"@en ;
    skos:broader ex:C032 ;
    skos:definition "Варіант, клінічне значення якого поки не встановлено."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C035" ;
    skos:prefLabel "variant of uncertain significance"@en,
        "варіант невизначеного значення"@uk .

ex:C038 a skos:Concept ;
    skos:broader ex:C037 ;
    skos:definition "Склад алелів особи в певному локусі або в усьому геномі."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C038" ;
    skos:prefLabel "genotype"@en,
        "генотип"@uk .

ex:C039 a skos:Concept ;
    skos:broader ex:C037 ;
    skos:definition "Спостережувані ознаки організму, результат взаємодії генотипу й середовища."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C039" ;
    skos:prefLabel "phenotype"@en,
        "фенотип"@uk .

ex:C040 a skos:Concept ;
    skos:broader ex:C037 ;
    skos:definition "Частка носіїв варіанта, у яких проявляється ознака."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C040" ;
    skos:prefLabel "penetrance"@en,
        "пенетрантність"@uk .

ex:C041 a skos:Concept ;
    skos:broader ex:C037 ;
    skos:definition "Тип успадкування, за якого достатньо однієї копії варіанта, щоб проявилась ознака."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C041" ;
    skos:prefLabel "autosomal dominant inheritance"@en,
        "аутосомно-домінантне успадкування"@uk .

ex:C043 a skos:Concept ;
    skos:broader ex:C042 ;
    skos:definition "Процес, у якому інформація гена використовується для синтезу продукту."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C043" ;
    skos:prefLabel "gene expression"@en,
        "експресія гена"@uk .

ex:C044 a skos:Concept ;
    skos:altLabel "methylation"@en ;
    skos:broader ex:C042 ;
    skos:definition "Додавання метильної групи до ДНК; епігенетичний механізм."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C044" ;
    skos:prefLabel "DNA methylation"@en,
        "метилювання ДНК"@uk .

ex:C045 a skos:Concept ;
    skos:altLabel "PTM"@en ;
    skos:broader ex:C042 ;
    skos:definition "Хімічна зміна білка після синтезу."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C045" ;
    skos:prefLabel "post-translational modification"@en,
        "посттрансляційна модифікація"@uk .

ex:C046 a skos:Concept ;
    skos:altLabel "PPI"@en ;
    skos:broader ex:C042 ;
    skos:definition "Фізичний чи функціональний контакт двох білків."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C046" ;
    skos:prefLabel "protein-protein interaction"@en,
        "білок-білкова взаємодія"@uk .

ex:C047 a skos:Concept ;
    skos:altLabel "protein level"@en,
        "protein quantity"@en ;
    skos:broader ex:C042 ;
    skos:definition "Кількість білка в зразку (відносна чи абсолютна)."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C047" ;
    skos:prefLabel "protein abundance"@en,
        "рівень білка"@uk .

ex:C051 a skos:Concept ;
    skos:altLabel "NGS"@en,
        "high-throughput sequencing"@en ;
    skos:broader ex:C050 ;
    skos:definition "Масово-паралельне секвенування ДНК або РНК."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C051" ;
    skos:prefLabel "next-generation sequencing"@en,
        "секвенування наступного покоління"@uk .

ex:C052 a skos:Concept ;
    skos:altLabel "WGS"@en ;
    skos:broader ex:C050 ;
    skos:definition "Секвенування всього геному особи."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C052" ;
    skos:prefLabel "whole genome sequencing"@en,
        "секвенування повного геному"@uk .

ex:C053 a skos:Concept ;
    skos:altLabel "WES"@en ;
    skos:broader ex:C050 ;
    skos:definition "Секвенування лише кодувальних ділянок геному."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C053" ;
    skos:prefLabel "whole exome sequencing"@en,
        "секвенування екзому"@uk .

ex:C054 a skos:Concept ;
    skos:altLabel "RNA-seq"@en ;
    skos:broader ex:C050 ;
    skos:definition "Секвенування РНК для оцінки транскриптому й експресії генів."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C054" ;
    skos:prefLabel "RNA sequencing"@en,
        "секвенування РНК"@uk .

ex:C056 a skos:Concept ;
    skos:altLabel "LC-MS/MS"@en,
        "MS/MS"@en ;
    skos:broader ex:C055 ;
    skos:definition "Мас-спектрометрія з фрагментацією іонів для визначення послідовності пептидів."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C056" ;
    skos:prefLabel "tandem mass spectrometry"@en,
        "тандемна мас-спектрометрія"@uk .

ex:C057 a skos:Concept ;
    skos:altLabel "lab test"@en ;
    skos:broader ex:C049 ;
    skos:definition "Аналіз зразка для отримання клінічно значущого результату."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C057" ;
    skos:prefLabel "laboratory test"@en,
        "лабораторне дослідження"@uk .

ex:C059 a skos:Concept ;
    skos:altLabel "mapping"@en,
        "read alignment"@en ;
    skos:broader ex:C058 ;
    skos:definition "Зіставлення ридів із позиціями референсного геному."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C059" ;
    skos:prefLabel "sequence alignment"@en,
        "вирівнювання послідовностей"@uk .

ex:C060 a skos:Concept ;
    skos:altLabel "variant detection"@en ;
    skos:broader ex:C058 ;
    skos:definition "Визначення варіантів за вирівняними ридами."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C060" ;
    skos:prefLabel "variant calling"@en,
        "виклик варіантів"@uk .

ex:C061 a skos:Concept ;
    skos:broader ex:C058 ;
    skos:definition "Додавання до варіантів відомостей про ген, наслідок і частоту."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C061" ;
    skos:prefLabel "variant annotation"@en,
        "анотація варіантів"@uk .

ex:C063 a skos:Concept ;
    skos:altLabel "hard-filtering"@en ;
    skos:broader ex:C062 ;
    skos:definition "Фільтрація варіантів за фіксованими порогами окремих анотацій."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C063" ;
    skos:prefLabel "hard filtering"@en,
        "жорстка фільтрація"@uk .

ex:C064 a skos:Concept ;
    skos:altLabel "VQSR"@en ;
    skos:broader ex:C062 ;
    skos:definition "Фільтрація моделлю, навченою на відомих варіантах (GATK)."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C064" ;
    skos:prefLabel "variant quality score recalibration"@en,
        "рекалібрація оцінок якості варіантів"@uk .

ex:C065 a skos:Concept ;
    skos:broader ex:C058 ;
    skos:definition "Визначення білків за спектрами через зіставлення з базою послідовностей."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C065" ;
    skos:prefLabel "protein identification"@en,
        "ідентифікація білків"@uk .

ex:C066 a skos:Concept ;
    skos:altLabel "kNN search"@en,
        "similarity search"@en ;
    skos:broader ex:C058 ;
    skos:definition "Пошук об'єктів, найближчих до запиту у векторному просторі."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C066" ;
    skos:prefLabel "nearest neighbor search"@en,
        "пошук найближчих сусідів"@uk .

ex:C069 a skos:Concept ;
    skos:broader ex:C068 ;
    skos:definition "Послідовне тестування родичів носія відомого патогенного варіанта."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C069" ;
    skos:prefLabel "cascade testing"@en,
        "каскадне тестування"@uk .

ex:C070 a skos:Concept ;
    skos:broader ex:C067 ;
    skos:definition "Допомога особі у розумінні генетичного ризику й варіантів дій."@uk ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D005817> ;
    skos:inScheme ex:scheme ;
    skos:notation "C070" ;
    skos:prefLabel "genetic counseling"@en,
        "генетичне консультування"@uk .

ex:C071 a skos:Concept ;
    skos:broader ex:C067 ;
    skos:definition "Оцінювання ймовірності виникнення захворювання."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C071" ;
    skos:prefLabel "risk assessment"@en,
        "оцінка ризику"@uk .

ex:C072 a skos:Concept ;
    skos:broader ex:C067 ;
    skos:definition "Дослідження за участю людей для оцінки втручання."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C072" ;
    skos:prefLabel "clinical trial"@en,
        "клінічне випробування"@uk .

ex:C074 a skos:Concept ;
    skos:broader ex:C073 ;
    skos:definition "Дослідження геномів, їхньої структури й варіації."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C074" ;
    skos:prefLabel "genomics"@en,
        "геноміка"@uk .

ex:C075 a skos:Concept ;
    skos:broader ex:C073 ;
    skos:definition "Масштабне дослідження білків та їхніх функцій."@uk ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D040901> ;
    skos:inScheme ex:scheme ;
    skos:notation "C075" ;
    skos:prefLabel "proteomics"@en,
        "протеоміка"@uk .

ex:C076 a skos:Concept ;
    skos:broader ex:C073 ;
    skos:definition "Вивчення спадкових змін активності генів без зміни послідовності ДНК."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C076" ;
    skos:prefLabel "epigenetics"@en,
        "епігенетика"@uk .

ex:C079 a skos:Concept ;
    skos:altLabel "read"@en,
        "sequence read"@en ;
    skos:broader ex:C078 ;
    skos:definition "Короткий фрагмент послідовності, отриманий секвенатором."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C079" ;
    skos:prefLabel "sequencing read"@en,
        "прочитання секвенування"@uk .

ex:C080 a skos:Concept ;
    skos:altLabel "FASTQ"@en ;
    skos:broader ex:C078 ;
    skos:definition "Формат для ридів із оцінками якості символів."@uk ;
    skos:inScheme ex:scheme ;
    skos:notation "C080" ;
    skos:prefLabel "FASTQ file"@en,
        "файл FASTQ"@uk .

ex:C081 a skos:Concept ;
    skos:altLabel "BAM"@en,
