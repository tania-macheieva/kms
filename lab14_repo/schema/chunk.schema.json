{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Chunk record","type":"object",
 "required":["chunk_id","doc_id","title","section","type","date","sensitivity","source_url","lang","text"],
 "properties":{"chunk_id":{"type":"string","pattern":"^[a-z0-9_]+#h[0-9]{3}$"},"doc_id":{"type":"string","pattern":"^[a-z0-9_]+$"},
  "title":{"type":"string","minLength":1},"section":{"type":"string","minLength":1},"type":{"type":"string"},
  "date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"sensitivity":{"enum":["public","internal","restricted"]},
  "source_url":{"type":"string","pattern":"^(https?://|local:)"},"lang":{"enum":["en","uk"]},"text":{"type":"string","minLength":20},
  "merged_from":{"type":"array","items":{"type":"object"}},"old_title":{"type":"string"}}}
