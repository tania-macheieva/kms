 "properties":{"status":{"enum":["active","alternative","superseded","outdated_flag"]},"confidence":{"type":"number","minimum":0,"maximum":1},
  "validFrom":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"validTo":{"type":["string","null"]},"decided_by":{"type":"string","minLength":5},"decided_at":{"type":"string"}}}
