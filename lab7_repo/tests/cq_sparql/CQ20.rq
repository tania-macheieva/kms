# id: CQ20
# question: Яка процедура потребує патогенного варіанта?
# lab4_cq: CQ14
# expect: ["cascade testing"]
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?answer WHERE {
  ?m rdfs:subClassOf ?r . ?r owl:onProperty ?p ; owl:someValuesFrom ?f .
  ?p rdfs:label "requires"@en . ?f rdfs:label "pathogenic variant"@en . ?m rdfs:label ?answer . FILTER(lang(?answer) = "en")
}
