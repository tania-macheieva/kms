# id: CQ17
# question: Які гени входять до панелі HBOC-panel?
# lab4_cq: CQ17
# expect: ["BRCA1", "BRCA2", "PALB2", "TP53"]
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?answer WHERE {
  ?panel rdfs:label "HBOC-panel"@en .
  { ?panel ?p ?g } UNION { ?g ?p ?panel }
  ?g rdf:type/rdfs:subClassOf* ?gc . ?gc rdfs:label "gene"@en . ?g rdfs:label ?answer
}
