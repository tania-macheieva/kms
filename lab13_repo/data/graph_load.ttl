ex:stmt0014 a ex:Statement ;
    ex:confidence 0.5 ;
    ex:docStartOffset 2247 ;
    ex:endOffset 359 ;
    ex:evidence "BWA-MEME used to map the reads to a reference genome. The aligned reads are coordinate sorted with samtools sort. These files are treated as intermediates and are not placed in the output folder by default. It is not the default aligner, but it can be chosen by setting `--aligner` option to bwameme." ;
    ex:method "rules" ;
    ex:model "spacy:en_core_web_md+rules" ;
    ex:passage "P033" ;
    ex:promptVersion "rules_v1" ;
    ex:source "rare_output" ;
    ex:startOffset 59 ;
    rdf:object ex:E0104 ;
    rdf:predicate ex:HAS_OPTION ;
    rdf:subject ex:E0105 .

